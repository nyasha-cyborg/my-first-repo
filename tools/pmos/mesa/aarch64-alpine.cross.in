[binaries]
c = ['clang', '--target=aarch64-alpine-linux-musl', '--sysroot=@SYSROOT@']
cpp = ['clang++', '--target=aarch64-alpine-linux-musl', '--sysroot=@SYSROOT@']
ar = 'llvm-ar'
strip = 'llvm-strip'
pkg-config = 'pkgconf'

[built-in options]
c_link_args = ['-fuse-ld=lld']
cpp_link_args = ['-fuse-ld=lld']

[properties]
sys_root = '@SYSROOT@'
pkg_config_libdir = ['@SYSROOT@/usr/lib/pkgconfig', '@SYSROOT@/usr/share/pkgconfig']

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'cortex-a57'
endian = 'little'
