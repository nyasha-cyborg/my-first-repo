#!/bin/busybox sh
# Boot ramdisk /init for postmarketOS on the Nexus 9 (flounder LTE).
# The root filesystem is an ext4 image file inside Android's userdata (UDA = mmcblk0p31):
#   /data/pmos/rootfs.img  ->  loop-mounted and switch_root'ed into (OpenRC /sbin/init).
# Android's userdata stays mounted at /android-data in pmOS (it backs the loop device: never unmount it).
# On any failure: a root shell on the USB serial gadget (/dev/ttyGS0, g_serial is built in).
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
log() { echo "<6>n9pmos: $*" > /dev/kmsg; }
rescue() {
	log "FAILED: $* -- rescue shell on ttyGS0"
	while true; do
		[ -c /dev/ttyGS0 ] && setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'
		sleep 2
	done
}
log "init start"
UDA=/dev/mmcblk0p31
IMG=${IMG:-pmos/rootfs.img}
for i in $(seq 1 100); do [ -b $UDA ] && break; sleep 0.1; done
[ -b $UDA ] || rescue "no $UDA"
mkdir -p /data /root
mount -t ext4 -o noatime $UDA /data || rescue "mount userdata"
[ -f /data/$IMG ] || rescue "no /data/$IMG"
L=$(losetup -f) && losetup $L /data/$IMG || rescue "losetup"
mount -t ext4 -o noatime $L /root || rescue "mount rootfs"
[ -x /root/sbin/init ] || rescue "no /sbin/init in the rootfs"
mkdir -p /root/android-data
mount --move /data /root/android-data
log "switching to the rootfs on $L"
umount /proc /sys
mount --move /dev /root/dev 2>/dev/null || umount /dev
exec switch_root /root /sbin/init
rescue "switch_root returned"
