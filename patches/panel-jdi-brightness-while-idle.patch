diff --git a/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
--- a/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
+++ b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
@@ -61,6 +61,15 @@
 	struct gpio_desc *dcdc_en_gpio;
 	struct gpio_desc *reset_gpio;
 
+	/*
+	 * Brightness has to be written while the link is idle: once the DC is
+	 * streaming, a command cannot be injected into the stream and the host
+	 * trigger never completes (-110). The value is therefore latched and
+	 * only ever written from prepare().
+	 */
+	u8 brightness;
+	bool streaming;
+
 	struct backlight_device *backlight;
 
 	/*
@@ -219,6 +228,14 @@
 					  0x55, 0x00);
 	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
 					  0x35, 0x00);
+	{
+		u8 payload[2] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				  jdi->brightness };
+
+		mipi_dsi_dual_dcs_write_buffer_multi(&dsi_ctx, jdi->link1,
+						     jdi->link2, payload,
+						     sizeof(payload));
+	}
 
 	mipi_dsi_dual(mipi_dsi_dcs_set_display_on_multi,
 		      &dsi_ctx, jdi->link1, jdi->link2);
@@ -231,6 +248,7 @@
 	jdi->link1->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	jdi->link2->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
+	jdi->streaming = true;
 	jdi->prepared = true;
 
 	return 0;
@@ -340,6 +358,15 @@
 	payload[0] = MIPI_DCS_SET_DISPLAY_BRIGHTNESS;
 	payload[1] = backlight_get_brightness(bl);
 
+	jdi->brightness = payload[1];
+
+	/*
+	 * While streaming, the write cannot reach the panel, so it is kept for
+	 * the next prepare() rather than sent into the stream and timing out.
+	 */
+	if (jdi->streaming)
+		return 0;
+
 	mipi_dsi_dual_dcs_write_buffer_multi(&dsi_ctx, jdi->link1, jdi->link2,
 					     payload, sizeof(payload));
 
@@ -361,6 +388,8 @@
 	};
 
 	jdi->mode = &default_mode;
+	/* same default as props.brightness, so the first prepare lights it */
+	jdi->brightness = 224;
 
 	/* The device tree supplies these two as regulators, not as GPIOs. */
 	jdi->iovdd = devm_regulator_get(dev, "iovdd");
