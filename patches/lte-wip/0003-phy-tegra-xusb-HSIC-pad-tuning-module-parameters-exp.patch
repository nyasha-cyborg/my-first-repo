From bb6478be9374e14519440fe8e9e0d28c2e7a675d Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Thu, 22 Oct 2026 18:44:43 +1300
Subject: [PATCH 3/5] phy: tegra xusb: HSIC pad tuning module parameters
 (experiment)

---
 drivers/phy/tegra/xusb-tegra124.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/phy/tegra/xusb-tegra124.c b/drivers/phy/tegra/xusb-tegra124.c
index 2162e32e5..dadb9dacc 100644
--- a/drivers/phy/tegra/xusb-tegra124.c
+++ b/drivers/phy/tegra/xusb-tegra124.c
@@ -860,6 +860,19 @@ static int tegra124_hsic_phy_exit(struct phy *phy)
 	return tegra124_xusb_padctl_disable(lane->pad->padctl);
 }
 
+/* Experiment knobs for the HSIC pad tuning (module parameters, -1 = keep). */
+static int n9_hsic_rx_strobe = -1, n9_hsic_rx_data = -1, n9_hsic_strobe_trim = -1;
+static int n9_hsic_tx_rtune_n = -1, n9_hsic_tx_rtune_p = -1;
+static int n9_hsic_tx_rslew_n = -1, n9_hsic_tx_rslew_p = -1, n9_hsic_auto_term = -1;
+module_param_named(hsic_rx_strobe, n9_hsic_rx_strobe, int, 0644);
+module_param_named(hsic_rx_data, n9_hsic_rx_data, int, 0644);
+module_param_named(hsic_strobe_trim, n9_hsic_strobe_trim, int, 0644);
+module_param_named(hsic_tx_rtune_n, n9_hsic_tx_rtune_n, int, 0644);
+module_param_named(hsic_tx_rtune_p, n9_hsic_tx_rtune_p, int, 0644);
+module_param_named(hsic_tx_rslew_n, n9_hsic_tx_rslew_n, int, 0644);
+module_param_named(hsic_tx_rslew_p, n9_hsic_tx_rslew_p, int, 0644);
+module_param_named(hsic_auto_term, n9_hsic_auto_term, int, 0644);
+
 static int tegra124_hsic_phy_power_on(struct phy *phy)
 {
 	struct tegra_xusb_lane *lane = phy_get_drvdata(phy);
@@ -876,6 +889,23 @@ static int tegra124_hsic_phy_power_on(struct phy *phy)
 			return err;
 	}
 
+	if (n9_hsic_rx_strobe >= 0)
+		hsic->rx_strobe_trim = n9_hsic_rx_strobe;
+	if (n9_hsic_rx_data >= 0)
+		hsic->rx_data_trim = n9_hsic_rx_data;
+	if (n9_hsic_strobe_trim >= 0)
+		hsic->strobe_trim = n9_hsic_strobe_trim;
+	if (n9_hsic_tx_rtune_n >= 0)
+		hsic->tx_rtune_n = n9_hsic_tx_rtune_n;
+	if (n9_hsic_tx_rtune_p >= 0)
+		hsic->tx_rtune_p = n9_hsic_tx_rtune_p;
+	if (n9_hsic_tx_rslew_n >= 0)
+		hsic->tx_rslew_n = n9_hsic_tx_rslew_n;
+	if (n9_hsic_tx_rslew_p >= 0)
+		hsic->tx_rslew_p = n9_hsic_tx_rslew_p;
+	if (n9_hsic_auto_term >= 0)
+		hsic->auto_term = n9_hsic_auto_term;
+
 	padctl_writel(padctl, hsic->strobe_trim,
 		      XUSB_PADCTL_HSIC_STRB_TRIM_CONTROL);
 
-- 
2.56.0

