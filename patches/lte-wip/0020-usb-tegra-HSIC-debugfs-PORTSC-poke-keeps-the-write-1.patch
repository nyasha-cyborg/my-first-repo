From 5489f179b56d0ad89bbae31fcb2cafb8d2d91618 Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Fri, 23 Oct 2026 01:26:15 +1300
Subject: [PATCH] usb: tegra HSIC: debugfs PORTSC poke keeps the
 write-1-to-clear change bits

---
 drivers/usb/phy/phy-tegra-usb.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/phy/phy-tegra-usb.c b/drivers/usb/phy/phy-tegra-usb.c
index 8147ab84d..f43661689 100644
--- a/drivers/usb/phy/phy-tegra-usb.c
+++ b/drivers/usb/phy/phy-tegra-usb.c
@@ -1549,7 +1549,15 @@ static ssize_t hsic_poke_write(struct file *file, const char __user *ubuf,
 		return -EINVAL;
 	if (!phy->powered_on)
 		return -ENODEV;
-	hsic_rmw(phy->regs, off, clear, set);
+	if (off == TEGRA_USB_PORTSC1_HOSTPC) {
+		/* PORTSC change bits (CSC/PEC/OCC) are write-1-to-clear: do not clear them by
+		 * writing back what was read, the hub needs to see the event */
+		u32 v = readl_relaxed(phy->regs + off) & ~(BIT(1) | BIT(3) | BIT(5));
+
+		writel_relaxed((v & ~clear) | set, phy->regs + off);
+	} else {
+		hsic_rmw(phy->regs, off, clear, set);
+	}
 	dev_info(phy->u_phy.dev, "n9: poke %03x set %08x clear %08x -> %08x\n",
 		 off, set, clear, readl_relaxed(phy->regs + off));
 	return len;
-- 
