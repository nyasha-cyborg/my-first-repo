From 189353253b78d97c179529173357992ff919ea9b Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Thu, 22 Oct 2026 22:02:53 +1300
Subject: [PATCH 18/18] usb: tegra HSIC: release PMC USB_AO pad isolation
 (vendor pmc wake detect powerup)

---
 drivers/usb/phy/phy-tegra-usb.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/usb/phy/phy-tegra-usb.c b/drivers/usb/phy/phy-tegra-usb.c
index 22ffd3c83..8147ab84d 100644
--- a/drivers/usb/phy/phy-tegra-usb.c
+++ b/drivers/usb/phy/phy-tegra-usb.c
@@ -772,6 +772,16 @@ static int hsic_phy_power_on(struct tegra_usb_phy *phy)
 	if (!pll)
 		return -EINVAL;
 
+	/*
+	 * Vendor uhsic_powerup_pmc_wake_detect: release the PMC USB_AO pad
+	 * isolation of the HSIC port (bits 19:16, or 15:12 for the second
+	 * port) that the bootloader leaves set.
+	 */
+	if (phy->pmc_regmap) {
+		regmap_clear_bits(phy->pmc_regmap, PMC_USB_AO, 0xff000);
+		dev_info(phy->u_phy.dev, "n9: hsic: cleared PMC USB_AO[19:12]\n");
+	}
+
 	if (phy->hsic_pad) {
 		err = phy_init(phy->hsic_pad);
 		if (err)
-- 
