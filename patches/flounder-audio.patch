+	/*
+	 * Speaker rail. Downstream gated the amplifiers' supply with the
+	 * tfa9895-power-enable pin, which is PX5 in the board file.
+	 */
+	spk_ldo: regulator-spk-ldo {
+		compatible = "regulator-fixed";
+		regulator-name = "spk-ldo";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&gpio TEGRA_GPIO(X, 5) GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	/*
+	 * Speaker card: one I2S and two amplifiers on a single stereo link.
+	 * No generic card driver expresses that shape, so the link is declared
+	 * by the machine driver this compatible matches.
+	 *
+	 * Expect the amplifiers at their hardware defaults: the acoustic
+	 * tuning the tablet shipped with was applied from the Android HAL over
+	 * ioctl, not from the device tree.
+	 */
+	sound-speakers {
+		compatible = "nvidia,tegra-audio-tfa989x-flounder";
+		nvidia,model = "Google Nexus 9 speakers";
+
+		nvidia,i2s-controller = <&tegra_i2s2>;
+		nvidia,audio-codec = <&tfa9895_r>, <&tfa9895_l>;
+
+		/* The amplifiers' pin is "OUT"; the prefix tells them apart. */
+		nvidia,audio-routing =
+			"Speakers", "Speaker Right OUT",
+			"Speakers", "Speaker Left OUT";
+
+		/*
+		 * The amplifiers run from BCLK and LRCK and need no mclk, but
+		 * the machine driver requires the clock spec to be present
+		 * because the shared Tegra I2S setup uses it.
+		 */
+		clocks = <&tegra_car TEGRA124_CLK_PLL_A>,
+			 <&tegra_car TEGRA124_CLK_PLL_A_OUT0>,
+			 <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
+		clock-names = "pll_a", "pll_a_out0", "mclk";
+
+		assigned-clocks = <&tegra_car TEGRA124_CLK_EXTERN1>,
+				  <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
+		assigned-clock-parents = <&tegra_car TEGRA124_CLK_PLL_A_OUT0>,
+					 <&tegra_car TEGRA124_CLK_EXTERN1>;
+	};
+
+	/*
+	 * Headphone/mic card on the codec in i2c@7000c400 (rt5677@2d).
+	 *
+	 * Flounder has a second, independent playback path: two tfa9895
+	 * speaker amplifiers hang off tegra_i2s2 (dap3 pins) and downstream
+	 * registered them from the board file with their own codec drivers.
+	 * This node covers the rt5677 only - the single-codec
+	 * nvidia,tegra-audio-rt5677 machine driver cannot express both links,
+	 * and the Tegra audio graph card does not support Tegra132.
+	 *
+	 * The mclk plumbing follows the Nexus 7, which uses the same machine
+	 * driver: the codec is fed from PLL_A via EXTERN1 on the PMC clock.
+	 */
+	sound {
+		compatible = "nvidia,tegra-audio-rt5677-flounder",
+			     "nvidia,tegra-audio-rt5677";
+		nvidia,model = "Google Nexus 9";
+
+		nvidia,audio-routing =
+			"Headphone", "LOUT1",
+			"Headphone", "LOUT2",
+			"IN1P", "Headset Mic",
+			"IN1N", "Headset Mic";
+
+		nvidia,i2s-controller = <&tegra_i2s1>;
+		nvidia,audio-codec = <&rt5677>;
+
+		clocks = <&tegra_car TEGRA124_CLK_PLL_A>,
+			 <&tegra_car TEGRA124_CLK_PLL_A_OUT0>,
+			 <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
+		clock-names = "pll_a", "pll_a_out0", "mclk";
+
+		assigned-clocks = <&tegra_car TEGRA124_CLK_EXTERN1>,
+				  <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
+		assigned-clock-parents = <&tegra_car TEGRA124_CLK_PLL_A_OUT0>,
+					 <&tegra_car TEGRA124_CLK_EXTERN1>;
+	};
