+/* Flounder speaker machine */
+
+/*
+ * The Nexus 9 drives both TFA9895 speaker amplifiers from one I2S controller,
+ * one amplifier per channel, so they belong on a single stereo DAI link.
+ *
+ * No generic card driver expresses that: simple-audio-card and audio-graph-card
+ * both hardcode one codec per link, the Tegra audio graph card stops at
+ * Tegra210, and nvidia,tegra30-i2s.yaml admits no graph ports anyway. Downstream
+ * shipped a board driver for the same reason - this is that link, with the
+ * array size declared in C where it is not a problem.
+ *
+ * The amplifiers take their clocks from BCLK and LRCK, so they need no mclk of
+ * their own; the Tegra I2S still does, which is what the shared mclk handling
+ * already here provides.
+ */
+
+SND_SOC_DAILINK_DEFS(flounder_spk,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "tfa989x-hifi"),
+			   COMP_CODEC(NULL, "tfa989x-hifi")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link tegra_flounder_spk_dai = {
+	.name = "TFA9895",
+	.stream_name = "TFA9895 PCM",
+	.init = tegra_asoc_machine_init,
+	.dai_fmt = SND_SOC_DAIFMT_I2S |
+		   SND_SOC_DAIFMT_NB_NF |
+		   SND_SOC_DAIFMT_CBC_CFC,
+	SND_SOC_DAILINK_REG(flounder_spk),
+};
+
+static struct snd_soc_card snd_soc_tegra_flounder_spk = {
+	.components = "codec:tfa989x",
+	.dai_link = &tegra_flounder_spk_dai,
+	.num_links = 1,
+	/*
+	 * No fully_routed: this card takes the shared widget set, which
+	 * carries headphone and microphone widgets flounder does not wire
+	 * here, and asserting completeness would fail on them.
+	 */
+};
+
+static const struct tegra_asoc_data tegra_flounder_spk_data = {
+	.mclk_rate = tegra_machine_mclk_rate_256,
+	.card = &snd_soc_tegra_flounder_spk,
+	.add_common_dapm_widgets = true,
+	.add_common_controls = true,
+	.add_common_snd_ops = true,
+};
