+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/nvidia,tegra-audio-tfa989x-flounder.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: NVIDIA Tegra audio complex with a pair of TFA989X speaker amplifiers
+
+maintainers:
+  - Nyasha <nmushambi@proton.me>
+
+description: |
+  The Google Nexus 9 drives both of its TFA9895 speaker amplifiers from a single
+  Tegra I2S controller, one amplifier per channel, so they belong on one stereo
+  DAI link.
+
+  No generic card driver expresses that shape. simple-audio-card and
+  audio-graph-card both hardcode one codec per link, the Tegra audio graph card
+  does not cover Tegra132, and nvidia,tegra30-i2s.yaml admits no graph ports.
+  The link is therefore declared by a machine driver.
+
+  This does not reference nvidia,tegra-audio-common.yaml, deliberately. That
+  binding types nvidia,audio-codec as a single phandle, and an allOf reference
+  is a conjunction, so the two-codec array here could not satisfy it. The
+  shared properties are restated below instead.
+
+  The amplifiers take their clocks from BCLK and LRCK and are I2S slaves, so
+  Tegra drives the bus and neither amplifier consumes mclk. The clock spec is
+  still required, because the shared Tegra machine setup uses it for the I2S
+  controller itself.
+
+properties:
+  compatible:
+    const: nvidia,tegra-audio-tfa989x-flounder
+
+  nvidia,model:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: The user-visible name of this sound complex.
+
+  nvidia,i2s-controller:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The phandle of the Tegra I2S controller.
+
+  nvidia,audio-codec:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    description: |
+      The two speaker amplifiers sharing the DAI link, one per channel.
+    minItems: 2
+    maxItems: 2
+
+  nvidia,audio-routing:
+    $ref: /schemas/types.yaml#/definitions/non-unique-string-array
+    description: |
+      Each amplifier exposes one DAPM pin, OUT, so both would otherwise be named
+      identically. The sound-name-prefix on each amplifier is what tells them
+      apart, and ASoC forms widget names as "<prefix> <widget>".
+    minItems: 2
+    items:
+      enum:
+        - Speakers
+        - Speaker Left OUT
+        - Speaker Right OUT
+
+  clocks:
+    maxItems: 3
+
+  clock-names:
+    items:
+      - const: pll_a
+      - const: pll_a_out0
+      - const: mclk
+
+  assigned-clocks: true
+
+  assigned-clock-parents: true
+
+required:
+  - compatible
+  - nvidia,i2s-controller
+  - nvidia,audio-codec
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    sound {
+        compatible = "nvidia,tegra-audio-tfa989x-flounder";
+        nvidia,model = "Google Nexus 9 speakers";
+
+        nvidia,i2s-controller = <&tegra_i2s2>;
+        nvidia,audio-codec = <&speaker_right>, <&speaker_left>;
+
+        nvidia,audio-routing =
+                "Speakers", "Speaker Right OUT",
+                "Speakers", "Speaker Left OUT";
+    };
