From 45145e3cf4e7b0b8e81dd2be185206ff010aeffd Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Tue, 20 Oct 2026 20:35:38 +1300
Subject: [PATCH 23/29] arm64: tegra132: flounder: enable BT LPO and fix BT
 power polarity

- clk-palmas: honour ti,clock-boot-enable like the vendor kernel; the
  BCM4354 needs the PMIC 32 kHz LPO to leave sleep
- DT: clock node boot-enabled; BT_REG_ON rfkill lines are active low
  (vendor DTB lists PR1 in gpio-output-low and bluedroid_pm powers on
  by setting shutdown to 0)
- serial-tegra: temporary n9dbg print of programmed baud and divisor

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 arch/arm64/boot/dts/nvidia/tegra132-flounder.dts | 12 +++++++++---
 drivers/clk/clk-palmas.c                         |  9 +++++++++
 drivers/tty/serial/serial-tegra.c                |  4 ++++
 3 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
index 026e15b3e..49be155a3 100644
--- a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
+++ b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
@@ -929,6 +929,9 @@ palmas_usb: palmas-usb {
 			clock {
 				compatible = "ti,palmas-clk32kg";
 				#clock-cells = <0>;
+				/* LPO for the BCM4354; the vendor kernel
+				 * boot-enables it as well. */
+				ti,clock-boot-enable;
 			};
 
 			pmic {
@@ -1213,9 +1216,12 @@ bt_rfkill: bluetooth-rfkill {
 		label = "bluetooth";
 		radio-type = "bluetooth";
 		/* rfkill-gpio probes reset before shutdown and aborts on a
-		 * NULL reset line, so point both at PR1. */
-		reset-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
-		shutdown-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
+		 * NULL reset line, so point both at PR1.  The vendor DTB
+		 * lists PR1 in gpio-output-low and bluedroid_pm powers the
+		 * section on by setting shutdown to 0: the line is active
+		 * low (low = powered, high = shutdown). */
+		reset-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_LOW>;
+		shutdown-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_LOW>;
 	};
 
 	/* BT_WAKE (PEE1) is deliberately not claimed here: Android's
diff --git a/drivers/clk/clk-palmas.c b/drivers/clk/clk-palmas.c
index 39049f62d..02fba7afb 100644
--- a/drivers/clk/clk-palmas.c
+++ b/drivers/clk/clk-palmas.c
@@ -264,6 +264,15 @@ static int palmas_clks_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	/* Vendor DT marks the 32 kHz outputs boot-enabled; several boards
+	 * (the flounder BT chip among them) need the LPO running even when
+	 * no driver consumes it. */
+	if (of_property_read_bool(node, "ti,clock-boot-enable")) {
+		ret = clk_prepare_enable(cinfo->hw.clk);
+		if (ret < 0)
+			dev_err(&pdev->dev, "Clock enable failed, %d\n", ret);
+	}
+
 	ret = of_clk_add_hw_provider(node, of_clk_hw_simple_get, &cinfo->hw);
 	if (ret < 0)
 		dev_err(&pdev->dev, "Fail to add clock driver, %d\n", ret);
diff --git a/drivers/tty/serial/serial-tegra.c b/drivers/tty/serial/serial-tegra.c
index 8004fc00f..a01c0ac3f 100644
--- a/drivers/tty/serial/serial-tegra.c
+++ b/drivers/tty/serial/serial-tegra.c
@@ -411,6 +411,10 @@ static int tegra_set_baudrate(struct tegra_uart_port *tup, unsigned int baud)
 		divisor = DIV_ROUND_CLOSEST(rate, baud * 16);
 	}
 
+	dev_info(tup->uport.dev,
+		 "n9dbg baud=%u rate=%lu div=%u actual=%lu\n",
+		 baud, rate, divisor, rate / (16 * divisor));
+
 	uart_port_lock_irqsave(&tup->uport, &flags);
 	lcr = tup->lcr_shadow;
 	lcr |= UART_LCR_DLAB;
-- 
