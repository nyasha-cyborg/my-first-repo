From d3a55d713d7e8f88b210be79b00317ce0d806b76 Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Sun, 18 Oct 2026 12:31:30 +1300
Subject: [PATCH 05/29] Drop the forced bootloader D-PHY timing values

- Mainline's computed timing displays correctly now that panel commands are
  injected into the video stream, so the hardcoded 0b080d06/070b1805/000000b5
  override is no longer needed
- Confirmed on hardware: console text appears with the computed values

Co-Authored-By: Claude Code with DeepSeek Flash v4.1 <noreply@anthropic.com>
---
 drivers/gpu/drm/tegra/dsi.c | 17 -----------------
 1 file changed, 17 deletions(-)

diff --git a/drivers/gpu/drm/tegra/dsi.c b/drivers/gpu/drm/tegra/dsi.c
index edd9e4391..35836c88c 100644
--- a/drivers/gpu/drm/tegra/dsi.c
+++ b/drivers/gpu/drm/tegra/dsi.c
@@ -1146,23 +1146,6 @@ static void tegra_dsi_encoder_enable(struct drm_encoder *encoder)
 	 */
 	tegra_dsi_set_phy_timing(dsi, state->period * 8, &state->timing);
 
-	/*
-	 * DIAG: the bootloader streams this panel at the same 371.5 MHz DSI
-	 * clock, so its PHY timing registers are a known-good reference:
-	 *   0x0b080d06 0x070b1805 0x000000b5
-	 * Mainline's computed values differ on every field. Use the
-	 * bootloader's for this experiment.
-	 */
-	{
-		struct tegra_dsi *s;
-
-		for (s = dsi; s; s = s->slave) {
-			tegra_dsi_writel(s, 0x0b080d06, DSI_PHY_TIMING_0);
-			tegra_dsi_writel(s, 0x070b1805, DSI_PHY_TIMING_1);
-			tegra_dsi_writel(s, 0x000000b5, DSI_PHY_TIMING_2);
-		}
-	}
-
 	tegra_dsi_configure(dsi, dc->pipe, mode);
 
 	/* enable display controller */
-- 
