From f6f5a53775226a51e974113b07f90f3b6bc7bc31 Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Tue, 20 Oct 2026 19:47:04 +1300
Subject: [PATCH 22/29] arm64: tegra132: flounder: expose BT_REG_ON through
 rfkill-gpio

- shutdown-only nodes never probe: rfkill-gpio drives reset-gpios
  unconditionally and aborts on a NULL line
- give reset-gpios and shutdown-gpios the same PR1 pin so the driver
  claims it and userspace can power-cycle via rfkill state

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 .../boot/dts/nvidia/tegra132-flounder.dts     | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
index 3771d6937..026e15b3e 100644
--- a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
+++ b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
@@ -1202,12 +1202,21 @@ usb2-0 {
 	};
 
 
-	/* BT_REG_ON (PR1) and BT_WAKE (PEE1) are deliberately not claimed
-	 * here: Android powers the section off and on again before every
-	 * init (BT_VND_PWR_ON forces power-off first) and drives BT_WAKE
-	 * per transaction.  Userspace tools in the diagnostic ramdisk own
-	 * both lines so they can reproduce that sequence.
+	/* BT_REG_ON (PR1) exposed as an rfkill switch, the same interface
+	 * Android's libbt-vendor writes ("BT_VND_PWR_ON forces power-off
+	 * first").  Userspace writes /sys/class/rfkill/rfkillN/state to
+	 * power-cycle the section.  BT_WAKE (PEE1) is deliberately not
+	 * claimed here; btwake drives it per transaction.
 	 */
+	bt_rfkill: bluetooth-rfkill {
+		compatible = "rfkill-gpio";
+		label = "bluetooth";
+		radio-type = "bluetooth";
+		/* rfkill-gpio probes reset before shutdown and aborts on a
+		 * NULL reset line, so point both at PR1. */
+		reset-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
+		shutdown-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
+	};
 
 	/* BT_WAKE (PEE1) is deliberately not claimed here: Android's
 	 * bluedroid_pm drives it dynamically (low on idle, high to wake).
-- 
