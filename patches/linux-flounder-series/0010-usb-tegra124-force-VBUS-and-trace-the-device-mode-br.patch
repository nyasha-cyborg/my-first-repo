 	}
 
 	if (dr_mode == USB_DR_MODE_OTG || dr_mode == USB_DR_MODE_PERIPHERAL) {
+		n9_mark(9, 0);
 		ret = ci_hdrc_gadget_init(ci);
+		n9_mark(10, ret);
