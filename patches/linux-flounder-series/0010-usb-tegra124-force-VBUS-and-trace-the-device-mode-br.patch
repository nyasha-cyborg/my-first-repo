+	n9_mark(1, 0);
+
 	usb = devm_kzalloc(&pdev->dev, sizeof(*usb), GFP_KERNEL);
 	if (!usb)
 		return -ENOMEM;
@@ -290,20 +450,25 @@ static int tegra_usb_probe(struct platform_device *pdev)
 		return -EINVAL;
 	}
 
+	dev_info(&pdev->dev, "n9: step phy\n");
 	usb->phy = devm_usb_get_phy_by_phandle(&pdev->dev, "nvidia,phy", 0);
 	if (IS_ERR(usb->phy))
 		return dev_err_probe(&pdev->dev, PTR_ERR(usb->phy),
 				     "failed to get PHY");
+	n9_mark(2, 0);
 
+	dev_info(&pdev->dev, "n9: step clk\n");
 	usb->clk = devm_clk_get(&pdev->dev, NULL);
 	if (IS_ERR(usb->clk))
 		return dev_err_probe(&pdev->dev, PTR_ERR(usb->clk),
 				     "failed to get clock");
 
+	dev_info(&pdev->dev, "n9: step opp\n");
 	err = devm_tegra_core_dev_init_opp_table_common(&pdev->dev);
 	if (err)
 		return err;
 
+	dev_info(&pdev->dev, "n9: step pm\n");
 	pm_runtime_enable(&pdev->dev);
 	err = pm_runtime_resume_and_get(&pdev->dev);
 	if (err)
@@ -312,6 +477,7 @@ static int tegra_usb_probe(struct platform_device *pdev)
 	if (device_property_present(&pdev->dev, "nvidia,needs-double-reset"))
 		usb->needs_double_reset = true;
 
+	dev_info(&pdev->dev, "n9: step reset\n");
 	err = tegra_usb_reset_controller(&pdev->dev);
 	if (err) {
 		dev_err_probe(&pdev->dev, err, "failed to reset controller");
@@ -323,9 +489,12 @@ static int tegra_usb_probe(struct platform_device *pdev)
 	 * initialized, otherwise CPU will hang because clocks are gated.
 	 * PHY driver controls gating of internal USB clocks on Tegra.
 	 */
+	dev_info(&pdev->dev, "n9: step phy_init\n");
 	err = usb_phy_init(usb->phy);
 	if (err)
 		goto fail_power_off;
+	n9_mark(3, err);
+	dev_info(&pdev->dev, "n9: step add_device\n");
 
 	/* setup and register ChipIdea HDRC device */
 	usb->soc = soc;
@@ -342,8 +511,10 @@ static int tegra_usb_probe(struct platform_device *pdev)
 	if (of_usb_get_phy_mode(pdev->dev.of_node) == USBPHY_INTERFACE_MODE_ULPI)
 		usb->data.flags &= ~CI_HDRC_SUPPORTS_RUNTIME_PM;
 
+	n9_mark(4, 0);
 	usb->dev = ci_hdrc_add_device(&pdev->dev, pdev->resource,
 				      pdev->num_resources, &usb->data);
+	n9_mark(5, IS_ERR(usb->dev) ? (unsigned long)PTR_ERR(usb->dev) : 0);
 	if (IS_ERR(usb->dev)) {
 		err = dev_err_probe(&pdev->dev, PTR_ERR(usb->dev),
 				    "failed to add HDRC device");
diff --git a/drivers/usb/chipidea/core.c b/drivers/usb/chipidea/core.c
