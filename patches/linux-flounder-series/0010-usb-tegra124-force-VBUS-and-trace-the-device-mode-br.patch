 #include "ci.h"
 
+/*
+ * Temporary N9 USB bring-up trace.
+ *
+ * The controller wedges the machine in device mode, sometimes before
+ * userspace runs, so there is no log to read.  Breadcrumbs go into PMC
+ * scratch registers, which survive a warm reset.  The next boot detects the
+ * magic, prints the breadcrumbs into the kernel log (visible in the init
+ * dump) and skips USB entirely so that it can reach userspace.  Every
+ * tracing boot arms a 30 s timer that hard-resets into the bootloader if the
+ * checkpoints stall.
+ */
+#define N9_PMC_PHYS	0x7000e400UL
+#define N9_PMC_CNTRL	0x000
+#define N9_SCRATCH0	0x050
+#define N9_MAGIC	0x4e395452	/* "N9TR" */
+#define N9_MAG_SLOT	8
+#define N9_FIRST_CODE	1
+#define N9_LAST_CODE	22
+#define N9_DONE_CODE	15
+
+static void __iomem *n9_pmc;
+bool n9_reader_mode;
+
+static void __iomem *n9_pmc_base(void)
+{
+	if (!n9_pmc)
+		n9_pmc = ioremap(N9_PMC_PHYS, 0x400);
+
+	return n9_pmc;
+}
+
+void n9_mark(unsigned int code, unsigned long val)
+{
+	void __iomem *base = n9_pmc_base();
+
+	if (n9_reader_mode || !base)
+		return;
+	if (code < N9_FIRST_CODE || code > N9_LAST_CODE)
+		return;
+
+	writel(N9_MAGIC, base + N9_SCRATCH0 + N9_MAG_SLOT * 4);
+	writel(0x4e000000 | (val & 0x00ffffff),
+	       base + N9_SCRATCH0 + (N9_MAG_SLOT + code) * 4);
+}
+EXPORT_SYMBOL_GPL(n9_mark);
+
+/*
+ * Fine-grained progress: a single known-writable scratch register holding the
+ * number of the last step reached.  Some of the PMC scratch registers are
+ * used by the bootloader and appear not to keep our writes, so this sticks to
+ * one slot that is known to work.
+ */
+#define N9_STEP_SLOT	(N9_MAG_SLOT + 16)
+
+void n9_step(unsigned int step)
+{
+	void __iomem *base = n9_pmc_base();
+
+	if (n9_reader_mode || !base)
+		return;
+
+	writel(N9_MAGIC, base + N9_SCRATCH0 + N9_MAG_SLOT * 4);
+	writel(0x4e000000 | (step & 0xff),
+	       base + N9_SCRATCH0 + N9_STEP_SLOT * 4);
+}
+EXPORT_SYMBOL_GPL(n9_step);
+
+static void n9_reset_timer(struct timer_list *t)
+{
+	void __iomem *base = n9_pmc_base();
+
+	if (!base)
+		return;
+
+	/* Userspace is running, so the probe did not wedge the machine. */
+	if (system_state >= SYSTEM_RUNNING)
+		return;
+
+	pr_emerg("n9trace: checkpoints stalled, resetting to bootloader\n");
+
+	/* Same effect as reboot(RB_RESTART2, "bootloader"), without the
+	 * reboot framework: hboot reads SCRATCH0 bit 30 and enters fastboot.
+	 */
+	writel(readl(base + N9_SCRATCH0) | BIT(30), base + N9_SCRATCH0);
+	writel(readl(base + N9_PMC_CNTRL) | BIT(4), base + N9_PMC_CNTRL);
+}
+static DEFINE_TIMER(n9_reset, n9_reset_timer);
+
+static int __init n9_trace_init(void)
+{
+	void __iomem *base = n9_pmc_base();
+	bool trigger = saved_command_line &&
+		       strstr(saved_command_line, "n9.trigger");
+	unsigned int i;
+
+	if (!base)
+		return 0;
+
+	if (!trigger &&
+	    (strstr(boot_command_line, "n9.reader") ||
+	     readl(base + N9_SCRATCH0 + N9_MAG_SLOT * 4) == N9_MAGIC)) {
+		n9_reader_mode = true;
+		pr_info("n9trace: breadcrumbs from the previous boot:\n");
+		for (i = N9_FIRST_CODE; i <= N9_LAST_CODE; i++) {
+			u32 v = readl(base + N9_SCRATCH0 +
+				      (N9_MAG_SLOT + i) * 4);
+
+			if (v)
+				pr_info("n9trace: %2u: 0x%08x\n", i, v);
+		}
+		writel(0, base + N9_SCRATCH0 + N9_MAG_SLOT * 4);
+		return 0;
+	}
+
+	for (i = N9_FIRST_CODE; i <= N9_LAST_CODE; i++)
+		writel(0, base + N9_SCRATCH0 + (N9_MAG_SLOT + i) * 4);
+
+	mod_timer(&n9_reset, jiffies + 8 * HZ);
+
+	return 0;
+}
+core_initcall(n9_trace_init);
