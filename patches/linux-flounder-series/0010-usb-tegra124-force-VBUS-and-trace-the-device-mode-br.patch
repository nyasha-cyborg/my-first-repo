 		/* sentinel */
 	}
@@ -274,10 +416,28 @@ static void tegra_usb_enter_lpm(struct ci_hdrc *ci, bool enable)
 
 static int tegra_usb_probe(struct platform_device *pdev)
 {
+	static bool n9_trigger_done;
 	const struct tegra_usb_soc_info *soc;
