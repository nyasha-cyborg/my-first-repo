+	n9_step(7);
 
 	if (hw_read(ci, OP_USBMODE, USBMODE_CM) != USBMODE_CM_DC) {
 		dev_err(ci->dev, "cannot enter in %s device mode\n",
@@ -511,8 +519,10 @@ int hw_device_reset(struct ci_hdrc *ci)
 		dev_err(ci->dev, "lpm = %i\n", ci->hw_bank.lpm);
