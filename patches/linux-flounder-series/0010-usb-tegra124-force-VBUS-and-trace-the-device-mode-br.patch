 #include <linux/slab.h>
@@ -1848,13 +1849,20 @@ static void ci_hdrc_gadget_connect(struct usb_gadget *_gadget, int is_active)
 	struct ci_hdrc *ci = container_of(_gadget, struct ci_hdrc, gadget);
 
 	if (is_active) {
+		n9_step(13);
 		pm_runtime_get_sync(ci->dev);
 		hw_device_reset(ci);
+		n9_step(10);
 		spin_lock_irq(&ci->lock);
 		if (ci->driver) {
 			hw_device_state(ci, ci->ep0out->qh.dma);
 			usb_gadget_set_state(_gadget, USB_STATE_POWERED);
 			spin_unlock_irq(&ci->lock);
+			dev_info(ci->dev,
+				 "n9: connected usbmode=%08x usbcmd=%08x portsc=%08x\n",
+				 hw_read(ci, OP_USBMODE, ~0),
+				 hw_read(ci, OP_USBCMD, ~0),
+				 hw_read(ci, OP_PORTSC, ~0));
 			usb_udc_vbus_handler(_gadget, true);
 		} else {
 			spin_unlock_irq(&ci->lock);
@@ -1965,11 +1973,36 @@ static int ci_udc_pullup(struct usb_gadget *_gadget, int is_on)
 	if (ci_otg_is_fsm_mode(ci) || ci->role == CI_ROLE_HOST)
 		return 0;
 
+	{
+		void __iomem *phy = ioremap(0x7d000000 + 0x400, 0x100);
+		void __iomem *pc = ioremap(0x7009f000, 0x1000);
+
+		if (phy) {
+			dev_info(ci->dev,
+				 "n9: phy susp=%08x vbus=%08x wake=%08x\n",
+				 readl(phy), readl(phy + 4), readl(phy + 8));
+			iounmap(phy);
+		}
+		if (pc) {
+			u32 old = readl(pc + 0x8);
+			u32 v = old & ~0x3u;
+
+			v |= 0x2;	/* USB2_PORT_CAP port 0: DEVICE */
+			writel(v, pc + 0x8);
+			dev_info(ci->dev, "n9: portcap %08x -> %08x\n",
+				 old, readl(pc + 0x8));
+			iounmap(pc);
+		}
+	}
+
 	pm_runtime_get_sync(ci->dev);
 	if (is_on)
