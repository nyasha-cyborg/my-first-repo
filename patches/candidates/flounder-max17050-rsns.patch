From 3171a4096a4f4274bc04e7e7bebf2ab6bded2e8c Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Sat, 24 Oct 2026 20:29:24 +1300
Subject: [PATCH] arm64: tegra132: flounder: describe the MAX17050 sense
 resistor

Without maxim,rsns-microohm the max17042 driver treats the gauge as
voltage-only and writes CGAIN=0, MiscCFG=0x0003 and LearnCFG=0x0007 at
probe. Those registers survive reboots, so the coulomb counter stops and
RepSOC freezes for every OS until the battery is disconnected. Flounder
has a 10 mOhm sense resistor (DesignCap 0x33c0 = 6624 mAh at 0.5 mAh/LSB).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/nvidia/tegra132-flounder.dts | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
index ed23c68ec..d21b9ac47 100644
--- a/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
+++ b/arch/arm64/boot/dts/nvidia/tegra132-flounder.dts
@@ -745,10 +745,15 @@ i2c@7000c000 {
 		status = "okay";
 		clock-frequency = <400000>;
 
-		/* NOTE: Enabling this breaks the battery meter in Android until the battery is disconnected */
 		max17050@36 {
 			compatible = "maxim,max17050";
 			reg = <0x36>;
+			/*
+			 * 10 mOhm sense resistor. Without this the driver puts the
+			 * gauge in voltage-only mode (CGAIN = 0), which persists in
+			 * the gauge and freezes RepSOC for Android as well.
+			 */
+			maxim,rsns-microohm = <10000>;
 			maxim,cold-temp = <(-1)>;
 			maxim,over-heat-temp = <551>;
 			maxim,over-volt = <4352>;
-- 
