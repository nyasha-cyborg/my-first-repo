+/*
+ * GK20A: reset GR before loading the ctxsw ucode, as the vendor driver does on
+ * every power-on (nvgpu gk20a_init_gr_prepare + gk20a_init_gr_reset_enable_hw).
+ * The MC reset map has no GR entry, so without this GR starts in whatever state
+ * it was left in; on some boots FECS then never answered its first method
+ * (gr: init failed, -110) and GPC registers faulted on the priv ring.
+ */
+static void
+gk20a_gr_reset_hw(struct gf100_gr *gr)
+{
+	struct nvkm_device *device = gr->base.engine.subdev.device;
+
+	/* disable FIFO access, reset PGRAPH + BLG + PERFMON, re-enable */
+	if (nvkm_rd32(device, 0x000200) & 0x00001000)
+		nvkm_mask(device, 0x400500, 0x00000001, 0x00000000);
+	nvkm_mask(device, 0x000200, 0x18001000, 0x00000000);
+	nvkm_rd32(device, 0x000200);
+	udelay(20);
+	nvkm_mask(device, 0x000200, 0x18001000, 0x18001000);
+	nvkm_rd32(device, 0x000200);
+	udelay(20);
+	nvkm_wr32(device, 0x400500, 0x00010001);
+
+	nvkm_wr32(device, 0x400100, 0xffffffff);
+	nvkm_wr32(device, 0x40013c, 0xffffffff);
+
+	/* FE power mode force-on, reset FECS/GPCCS, back to auto */
+	nvkm_wr32(device, 0x404170, 0x00000012);
+	nvkm_msec(device, 2000,
+		if (!(nvkm_rd32(device, 0x404170) & 0x00000010))
+			break;
+	);
+	nvkm_wr32(device, 0x409614, 0x00000070);
+	nvkm_rd32(device, 0x409614);
+	udelay(20);
+	nvkm_wr32(device, 0x409614, 0x00000770);
+	nvkm_rd32(device, 0x409614);
+	udelay(20);
+	nvkm_wr32(device, 0x404170, 0x00000010);
+	nvkm_msec(device, 2000,
+		if (!(nvkm_rd32(device, 0x404170) & 0x00000010))
+			break;
+	);
+}
+
 int
 gk20a_gr_init(struct gf100_gr *gr)
 {
 	struct nvkm_device *device = gr->base.engine.subdev.device;
 	int ret;
 
+	if (device->chipset == 0xea)
+		gk20a_gr_reset_hw(gr);
+
 	/* Clear SCC RAM */
 	nvkm_wr32(device, 0x40802c, 0x1);
 
