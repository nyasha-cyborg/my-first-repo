From 80bf289b11b8a246fd64e0645336913eda616e53 Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Sun, 25 Oct 2026 10:33:18 +1300
Subject: [PATCH] WIP drm/panel: jdi-lpm089a128a: debugfs cmd file for live
 DCS/MCS writes and reads

Bring-up aid for the content-dependent backlight pulsing: send DCS or
generic (MCS) packets to both links while the panel is displaying, through
the same injected-at-vblank path the backlight uses, and DCS reads on link 1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
index 6551ff02c..2fa51db24 100644
--- a/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
+++ b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
@@ -15,6 +15,7 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -86,6 +87,9 @@ struct jdi_panel {
 
 	const struct drm_display_mode *mode;
 
+	/* debugfs "cmd": send DCS/MCS packets to the running panel (bring-up) */
+	struct dentry *debugfs;
+	char last[160];
 };
 
 static inline struct jdi_panel *to_panel_jdi(struct drm_panel *panel)
@@ -416,6 +420,8 @@ static const struct backlight_ops jdi_panel_bl_ops = {
 	.update_status = jdi_panel_bl_update_status,
 };
 
+static const struct file_operations jdi_debugfs_cmd_fops;
+
 static int jdi_panel_add(struct jdi_panel *jdi)
 {
 	struct device *dev = &jdi->link1->dev;
@@ -461,11 +467,103 @@ static int jdi_panel_add(struct jdi_panel *jdi)
 
 	drm_panel_add(&jdi->base);
 
+	jdi->debugfs = debugfs_create_dir("jdi-panel", NULL);
+	debugfs_create_file("cmd", 0600, jdi->debugfs, jdi, &jdi_debugfs_cmd_fops);
+
 	return 0;
 }
 
+/*
+ * Bring-up aid: send panel commands while it is displaying, to probe the
+ * panel controller's own settings (CABC, colour enhancement) live.
+ *   echo "dcs 55 00"   > /sys/kernel/debug/jdi-panel/cmd   DCS write, both links
+ *   echo "gen b0 04"   > ...                               generic (MCS) write, both links
+ *   echo "read 56 1"   > ...                               DCS read on link 1
+ *   cat /sys/kernel/debug/jdi-panel/cmd                    result of the last command
+ * Writes use the same path as the backlight: injected into the video stream.
+ */
+static ssize_t jdi_debugfs_cmd_write(struct file *file, const char __user *ubuf,
+				     size_t count, loff_t *ppos)
+{
+	struct jdi_panel *jdi = file->private_data;
+	struct mipi_dsi_multi_context dsi_ctx = {};
+	char kbuf[128], *p, *tok, kind[8] = "";
+	u8 data[32];
+	int n = 0, err = 0;
+	unsigned int v;
+
+	if (count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = 0;
+	p = strim(kbuf);
+
+	tok = strsep(&p, " ");
+	if (!tok)
+		return -EINVAL;
+	strscpy(kind, tok, sizeof(kind));
+	while ((tok = strsep(&p, " ")) && n < ARRAY_SIZE(data)) {
+		if (!*tok)
+			continue;
+		if (kstrtouint(tok, 16, &v) || v > 0xff)
+			return -EINVAL;
+		data[n++] = v;
+	}
+	if (!n)
+		return -EINVAL;
+	if (!jdi->prepared)
+		return -ENODEV;
+
+	if (!strcmp(kind, "dcs")) {
+		mipi_dsi_dual_dcs_write_buffer_multi(&dsi_ctx, jdi->link1,
+						     jdi->link2, data, n);
+		err = dsi_ctx.accum_err;
+		snprintf(jdi->last, sizeof(jdi->last), "dcs %*ph -> %d\n", n, data, err);
+	} else if (!strcmp(kind, "gen")) {
+		mipi_dsi_dual_generic_write_multi(&dsi_ctx, jdi->link1,
+						  jdi->link2, data, n);
+		err = dsi_ctx.accum_err;
+		snprintf(jdi->last, sizeof(jdi->last), "gen %*ph -> %d\n", n, data, err);
+	} else if (!strcmp(kind, "read") && n == 2 && data[1] && data[1] <= 16) {
+		u8 rbuf[16];
+		int len = data[1];
+
+		err = mipi_dsi_dcs_read(jdi->link1, data[0], rbuf, len);
+		if (err < 0)
+			snprintf(jdi->last, sizeof(jdi->last), "read %02x -> %d\n", data[0], err);
+		else
+			snprintf(jdi->last, sizeof(jdi->last), "read %02x -> %*ph\n", data[0],
+				 err, rbuf);
+	} else {
+		return -EINVAL;
+	}
+
+	dev_info(&jdi->link1->dev, "debugfs %s", jdi->last);
+	return err < 0 ? err : count;
+}
+
+static ssize_t jdi_debugfs_cmd_read(struct file *file, char __user *ubuf,
+				    size_t count, loff_t *ppos)
+{
+	struct jdi_panel *jdi = file->private_data;
+
+	return simple_read_from_buffer(ubuf, count, ppos, jdi->last,
+				       strlen(jdi->last));
+}
+
+static const struct file_operations jdi_debugfs_cmd_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = jdi_debugfs_cmd_write,
+	.read = jdi_debugfs_cmd_read,
+	.llseek = default_llseek,
+};
+
 static void jdi_panel_del(struct jdi_panel *jdi)
 {
+	debugfs_remove_recursive(jdi->debugfs);
+
 	drm_panel_remove(&jdi->base);
 
 	if (jdi->link2)
-- 
