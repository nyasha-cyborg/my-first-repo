From 3a298fa69c9614b7ee0e30f881b2a7240602aed5 Mon Sep 17 00:00:00 2001
From: nyasha <nmushambi@proton.me>
Date: Sat, 24 Oct 2026 01:11:09 +1300
Subject: [PATCH 1/3] WIP media: tegra-vde: Tegra132 bring-up (IRAM pool, BSE-V
 clock/reset, DT node)

- tegra132.dtsi: mmio-sram IRAM node with a 4 KiB VDE pool at the top,
  VDE node (T114-compatible register map, SPI 9/10/12), VDE + BSE-V clocks
  and resets, SMMU swgroup
- tegra-vde: optional "bsev" clock and reset (separate gate on T124/T132;
  the stock nvavp enables both clocks around the VDE partition power-up)
- T124 decoded formats: YUV420M placeholder so userspace can negotiate
  while the T124 tiled output layout is studied (bring-up only)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/nvidia/tegra132.dtsi      | 45 +++++++++++++++++++
 drivers/media/platform/nvidia/tegra-vde/vde.c | 25 ++++++++++-
 drivers/media/platform/nvidia/tegra-vde/vde.h |  2 +
 3 files changed, 71 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/nvidia/tegra132.dtsi b/arch/arm64/boot/dts/nvidia/tegra132.dtsi
index 2c1a7a915..fbbdd60af 100644
--- a/arch/arm64/boot/dts/nvidia/tegra132.dtsi
+++ b/arch/arm64/boot/dts/nvidia/tegra132.dtsi
@@ -83,6 +83,23 @@ pci@2,0 {
 		};
 	};
 
+	sram@40000000 {
+		compatible = "mmio-sram";
+		reg = <0x0 0x40000000 0x0 0x40000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0 0x0 0x40000000 0x40000>;
+
+		/*
+		 * VDE reference lists (the driver needs ~1 KiB). Kept at the top
+		 * of IRAM, away from the boot-time users at the bottom.
+		 */
+		vde_pool: sram@3f000 {
+			reg = <0x3f000 0x1000>;
+			pool;
+		};
+	};
+
 	host1x@50000000 {
 		compatible = "nvidia,tegra132-host1x",
 			     "nvidia,tegra124-host1x";
@@ -316,6 +333,34 @@ gpio: gpio@6000d000 {
 		interrupt-controller;
 	};
 
+	vde@6001a000 {
+		compatible = "nvidia,tegra132-vde", "nvidia,tegra124-vde";
+		reg = <0x0 0x6001a000 0x0 0x1000>, /* Syntax Engine */
+		      <0x0 0x6001b000 0x0 0x1000>, /* Video Bitstream Engine */
+		      <0x0 0x6001c000 0x0  0x100>, /* Macroblock Engine */
+		      <0x0 0x6001c200 0x0  0x100>, /* Post-processing Engine */
+		      <0x0 0x6001c400 0x0  0x100>, /* Motion Compensation Engine */
+		      <0x0 0x6001c600 0x0  0x100>, /* Transform Engine */
+		      <0x0 0x6001c800 0x0  0x100>, /* Pixel prediction block */
+		      <0x0 0x6001ca00 0x0  0x100>, /* Video DMA */
+		      <0x0 0x6001d800 0x0  0x400>; /* Video frame controls */
+		reg-names = "sxe", "bsev", "mbe", "ppe", "mce",
+			    "tfe", "ppb", "vdma", "frameid";
+		iram = <&vde_pool>; /* IRAM region */
+		interrupts = <GIC_SPI  9 IRQ_TYPE_LEVEL_HIGH>, /* Sync token interrupt */
+			     <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>, /* BSE-V interrupt */
+			     <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>; /* SXE interrupt */
+		interrupt-names = "sync-token", "bsev", "sxe";
+		/* BSEV: separate gate on T124/T132; the stock nvavp enables both */
+		clocks = <&tegra_car TEGRA124_CLK_VDE>,
+			 <&tegra_car TEGRA124_CLK_BSEV>;
+		clock-names = "vde", "bsev";
+		resets = <&tegra_car 61>, <&mc TEGRA124_MC_RESET_VDE>,
+			 <&tegra_car 63>;
+		reset-names = "vde", "mc", "bsev";
+		iommus = <&mc TEGRA_SWGROUP_VDE>;
+	};
+
 	apbdma: dma-controller@60020000 {
 		compatible = "nvidia,tegra124-apbdma", "nvidia,tegra148-apbdma";
 		reg = <0x0 0x60020000 0x0 0x1400>;
diff --git a/drivers/media/platform/nvidia/tegra-vde/vde.c b/drivers/media/platform/nvidia/tegra-vde/vde.c
index 3232392c6..8c0d8d4fe 100644
--- a/drivers/media/platform/nvidia/tegra-vde/vde.c
+++ b/drivers/media/platform/nvidia/tegra-vde/vde.c
@@ -169,6 +169,8 @@ static __maybe_unused int tegra_vde_runtime_suspend(struct device *dev)
 	}
 
 	clk_disable_unprepare(vde->clk);
+	reset_control_assert(vde->rst_bsev);
+	clk_disable_unprepare(vde->clk_bsev);
 	reset_control_release(vde->rst);
 	reset_control_release(vde->rst_mc);
 
@@ -192,6 +194,13 @@ static __maybe_unused int tegra_vde_runtime_resume(struct device *dev)
 		goto release_mc_reset;
 	}
 
+	err = clk_prepare_enable(vde->clk_bsev);
+	if (err) {
+		dev_err(dev, "Failed to enable BSE-V clock: %d\n", err);
+		goto release_reset;
+	}
+	reset_control_deassert(vde->rst_bsev);
+
 	if (!dev->pm_domain) {
 		err = tegra_powergate_sequence_power_up(TEGRA_POWERGATE_VDEC,
 							vde->clk, vde->rst);
@@ -279,6 +288,16 @@ static int tegra_vde_probe(struct platform_device *pdev)
 		return err;
 	}
 
+	vde->clk_bsev = devm_clk_get_optional(dev, "bsev");
+	if (IS_ERR(vde->clk_bsev))
+		return dev_err_probe(dev, PTR_ERR(vde->clk_bsev),
+				     "Could not get BSE-V clk\n");
+
+	vde->rst_bsev = devm_reset_control_get_optional_exclusive(dev, "bsev");
+	if (IS_ERR(vde->rst_bsev))
+		return dev_err_probe(dev, PTR_ERR(vde->rst_bsev),
+				     "Could not get BSE-V reset\n");
+
 	vde->rst = devm_reset_control_get_exclusive_released(dev, NULL);
 	if (IS_ERR(vde->rst)) {
 		err = PTR_ERR(vde->rst);
@@ -456,7 +475,11 @@ static const struct dev_pm_ops tegra_vde_pm_ops = {
 };
 
 static const u32 tegra124_decoded_fmts[] = {
-	/* TBD: T124 supports only a non-standard Tegra tiled format */
+	/*
+	 * T124 writes a non-standard Tegra tiled layout. Bring-up only: offer
+	 * YUV420M so userspace can negotiate and the tiling can be studied.
+	 */
+	V4L2_PIX_FMT_YUV420M,
 };
 
 static const struct tegra_coded_fmt_desc tegra124_coded_fmts[] = {
diff --git a/drivers/media/platform/nvidia/tegra-vde/vde.h b/drivers/media/platform/nvidia/tegra-vde/vde.h
index b2890484b..cd84165d6 100644
--- a/drivers/media/platform/nvidia/tegra-vde/vde.h
+++ b/drivers/media/platform/nvidia/tegra-vde/vde.h
@@ -110,6 +110,8 @@ struct tegra_vde {
 	struct gen_pool *iram_pool;
 	struct completion decode_completion;
 	struct clk *clk;
+	struct clk *clk_bsev;		/* T124/T132: separate BSE-V gate */
+	struct reset_control *rst_bsev;
 	struct iommu_domain *domain;
 	struct iommu_group *group;
 	struct iova_domain iova;
-- 
2.56.0

