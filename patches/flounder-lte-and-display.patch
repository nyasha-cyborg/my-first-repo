diff --git a/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
new file mode 100644
index 000000000..c7c7cd48f
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-jdi-lpm089a128a.c
@@ -0,0 +1,515 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * DRM panel driver for the JDI LPM089A128A
+ *
+ * This is the 8.9" QXGA (1536x2048) panel in the Google Nexus 9, where it is
+ * driven as two ganged DSI links of four lanes each. The colour-management and
+ * smart-dimming tables the downstream driver carries are not implemented here;
+ * they are downstream-only features with no mainline equivalent.
+ *
+ * The sequences and timings come from the downstream Android driver
+ * `arch/arm/mach-tegra/panel-j-qxga-8-9.c` in
+ * LineageOS/android_kernel_htc_flounder (branch cm-14.1). Note that both that
+ * file's name and its symbols refer to the panel family -- "JDI QXGA 8.9" -- and
+ * not to the lpm089a128a part number the device tree matches on.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_print.h>
+
+#include <video/mipi_display.h>
+
+/*
+ * Manufacturer command set. These go out as generic packets rather than DCS
+ * commands, which is why they are not in video/mipi_display.h.
+ */
+#define JDI_MCS_PAGE_SELECT	0xb0
+#define JDI_MCS_PAGE_CE		0x04
+#define JDI_MCS_PAGE_DISPLAY	0x03
+#define JDI_MCS_CTRL		0xd6
+#define JDI_MCS_CTRL_ENABLE	0x01
+
+/*
+ * Parameter table written with the JDI_MCS_PAGE_CE page selected. The first byte
+ * is the command (0xce) and the remaining 23 are its payload.
+ */
+static const u8 jdi_ce_table[] = {
+	0xce, 0x5d, 0x40, 0x48, 0x56, 0x67, 0x78, 0x88,
+	0x98, 0xa7, 0xb5, 0xc3, 0xd1, 0xde, 0xe9, 0xf2,
+	0xfa, 0xff, 0x05, 0x00, 0x04, 0x04, 0x00, 0x20,
+};
+
+/* Delay between panel power-up and the first command, per the downstream order. */
+#define JDI_POWER_UP_DELAY_MS	15
+
+struct jdi_panel {
+	struct drm_panel base;
+	struct mipi_dsi_device *link1;
+	struct mipi_dsi_device *link2;
+
+	struct regulator *avdd;
+	struct regulator *iovdd;
+	struct gpio_desc *dcdc_en_gpio;
+	struct gpio_desc *reset_gpio;
+
+	struct backlight_device *backlight;
+
+	/*
+	 * Set once the panel is powered and out of reset. The backlight is a
+	 * separately registered device that userspace can write at any time, so
+	 * its DCS writes must not reach an unpowered panel.
+	 */
+	bool prepared;
+
+	const struct drm_display_mode *mode;
+};
+
+static inline struct jdi_panel *to_panel_jdi(struct drm_panel *panel)
+{
+	return container_of(panel, struct jdi_panel, base);
+}
+
+static void jdi_wait_frames(struct jdi_panel *jdi, unsigned int frames)
+{
+	unsigned int refresh = drm_mode_vrefresh(jdi->mode);
+
+	if (WARN_ON(frames > refresh))
+		return;
+
+	msleep(DIV_ROUND_UP(frames * 1000, refresh));
+}
+
+static int jdi_panel_disable(struct drm_panel *panel)
+{
+	struct jdi_panel *jdi = to_panel_jdi(panel);
+
+	/* Let the last frame land before the backlight goes off. */
+	jdi_wait_frames(jdi, 1);
+
+	backlight_disable(jdi->backlight);
+
+	return 0;
+}
+
+static int jdi_panel_unprepare(struct drm_panel *panel)
+{
+	struct jdi_panel *jdi = to_panel_jdi(panel);
+	struct mipi_dsi_multi_context dsi_ctx = {};
+	int err;
+
+	jdi->prepared = false;
+
+	jdi->link1->mode_flags |= MIPI_DSI_MODE_LPM;
+	jdi->link2->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/*
+	 * Downstream suspend order: brightness to zero, display off, then sleep.
+	 * 0x51 takes a single parameter byte on this panel, so it is written
+	 * out explicitly rather than with
+	 * mipi_dsi_dcs_set_display_brightness_multi(), which sends two.
+	 */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					  MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0);
+	mipi_dsi_dual(mipi_dsi_dcs_set_display_off_multi,
+		      &dsi_ctx, jdi->link1, jdi->link2);
+	mipi_dsi_dual(mipi_dsi_dcs_enter_sleep_mode_multi,
+		      &dsi_ctx, jdi->link1, jdi->link2);
+
+	jdi_wait_frames(jdi, 3);
+
+	/* Both of these are generic writes downstream, not DCS commands. */
+	mipi_dsi_dual_generic_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					      JDI_MCS_PAGE_SELECT, JDI_MCS_PAGE_CE);
+	mipi_dsi_dual_generic_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					      0xb1, 0x01);
+
+	/*
+	 * Power down even if the link errored. Returning early here would leave
+	 * both rails enabled, and prepare() would only ever enable them again,
+	 * so the imbalance would be permanent rather than a transient leak.
+	 */
+	err = dsi_ctx.accum_err;
+
+	/* Downstream power-down order, with its delays. */
+	gpiod_set_value(jdi->reset_gpio, 0);
+	msleep(1);
+	gpiod_set_value(jdi->dcdc_en_gpio, 0);
+	msleep(15);
+	regulator_disable(jdi->avdd);
+	regulator_disable(jdi->iovdd);
+	msleep(10);
+
+	return err;
+}
+
+static int jdi_panel_prepare(struct drm_panel *panel)
+{
+	struct jdi_panel *jdi = to_panel_jdi(panel);
+	struct mipi_dsi_multi_context dsi_ctx = {};
+	int err;
+
+	/* Blank the backlight before touching the panel, then let it settle. */
+	backlight_disable(jdi->backlight);
+	jdi_wait_frames(jdi, 3);
+
+	jdi->link1->mode_flags |= MIPI_DSI_MODE_LPM;
+	jdi->link2->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/* Power-up order and delays as the downstream driver has them. */
+	err = regulator_enable(jdi->iovdd);
+	if (err < 0) {
+		dev_err(panel->dev, "failed to enable iovdd: %d\n", err);
+		return err;
+	}
+	usleep_range(JDI_POWER_UP_DELAY_MS * 1000,
+		     JDI_POWER_UP_DELAY_MS * 1000 + 500);
+
+	err = regulator_enable(jdi->avdd);
+	if (err < 0) {
+		dev_err(panel->dev, "failed to enable avdd: %d\n", err);
+		goto iovdd_off;
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value(jdi->dcdc_en_gpio, 1);
+	usleep_range(JDI_POWER_UP_DELAY_MS * 1000,
+		     JDI_POWER_UP_DELAY_MS * 1000 + 500);
+
+	/* Reset is active high as the device tree declares it. */
+	gpiod_set_value(jdi->reset_gpio, 1);
+	usleep_range(JDI_POWER_UP_DELAY_MS * 1000,
+		     JDI_POWER_UP_DELAY_MS * 1000 + 500);
+
+	/*
+	 * No column/page address setup: the downstream init table has neither
+	 * 0x2a nor 0x2b, and in video mode the panel streams continuously, so
+	 * windowing does not apply. The left/right split between the two links
+	 * is the DSI host's business, via nvidia,ganged-mode.
+	 */
+	mipi_dsi_dual_generic_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					      JDI_MCS_PAGE_SELECT,
+					      JDI_MCS_PAGE_CE);
+	mipi_dsi_dual_generic_write_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					  jdi_ce_table, sizeof(jdi_ce_table));
+	mipi_dsi_dual_generic_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					      JDI_MCS_CTRL,
+					      JDI_MCS_CTRL_ENABLE);
+	mipi_dsi_dual_generic_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					      JDI_MCS_PAGE_SELECT,
+					      JDI_MCS_PAGE_DISPLAY);
+
+	mipi_dsi_dual(mipi_dsi_dcs_exit_sleep_mode_multi,
+		      &dsi_ctx, jdi->link1, jdi->link2);
+
+	/* The downstream driver waits 120 ms after exiting sleep. */
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					  0x53, 0x24);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					  0x55, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					  0x35, 0x00);
+
+	mipi_dsi_dual(mipi_dsi_dcs_set_display_on_multi,
+		      &dsi_ctx, jdi->link1, jdi->link2);
+
+	if (dsi_ctx.accum_err < 0) {
+		err = dsi_ctx.accum_err;
+		goto poweroff;
+	}
+
+	jdi->link1->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	jdi->link2->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	jdi->prepared = true;
+
+	return 0;
+
+poweroff:
+	gpiod_set_value(jdi->reset_gpio, 0);
+	msleep(1);
+	gpiod_set_value(jdi->dcdc_en_gpio, 0);
+	msleep(15);
+	regulator_disable(jdi->avdd);
+iovdd_off:
+	regulator_disable(jdi->iovdd);
+
+	return err;
+}
+
+static int jdi_panel_enable(struct drm_panel *panel)
+{
+	struct jdi_panel *jdi = to_panel_jdi(panel);
+
+	/* Let a few frames out before the backlight comes on. */
+	jdi_wait_frames(jdi, 3);
+
+	backlight_enable(jdi->backlight);
+
+	return 0;
+}
+
+static const struct drm_display_mode default_mode = {
+	.clock = 247600,			/* 247.6 MHz, 60 Hz */
+
+	.hdisplay = 1536,
+	.hsync_start = 1536 + 300,		/* + hfront porch */
+	.hsync_end = 1536 + 300 + 76,		/* + hsync width */
+	.htotal = 1536 + 300 + 76 + 80,		/* + hback porch */
+
+	.vdisplay = 2048,
+	.vsync_start = 2048 + 12,		/* + vfront porch */
+	.vsync_end = 2048 + 12 + 4,		/* + vsync width */
+	.vtotal = 2048 + 12 + 4 + 8,		/* + vback porch */
+
+	/*
+	 * The downstream driver does not state sync polarity, so none is set
+	 * here. If the panel comes up with a shifted or torn image, this is the
+	 * first thing to question.
+	 */
+	.flags = 0,
+};
+
+static int jdi_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	struct jdi_panel *jdi = to_panel_jdi(panel);
+	struct device *dev = &jdi->link1->dev;
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &default_mode);
+	if (!mode) {
+		dev_err(dev, "failed to add mode %ux%ux@%u\n",
+			default_mode.hdisplay, default_mode.vdisplay,
+			drm_mode_vrefresh(&default_mode));
+		return -ENOMEM;
+	}
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	/* 135 mm x 180 mm, a 3:4 panel a hair under 8.9" on the diagonal. */
+	connector->display_info.width_mm = 135;
+	connector->display_info.height_mm = 180;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs jdi_panel_funcs = {
+	.prepare = jdi_panel_prepare,
+	.enable = jdi_panel_enable,
+	.disable = jdi_panel_disable,
+	.unprepare = jdi_panel_unprepare,
+	.get_modes = jdi_panel_get_modes,
+};
+
+/*
+ * Backlight over DCS 0x51, as the panel has no PWM or enable line for it. The
+ * command has to reach both links, so the panel is the backlight's private data
+ * rather than a single mipi_dsi_device.
+ */
+static int jdi_panel_bl_update_status(struct backlight_device *bl)
+{
+	struct jdi_panel *jdi = bl_get_data(bl);
+	struct mipi_dsi_multi_context dsi_ctx = {};
+	u8 payload[2];
+
+	/* Writing DCS to an unpowered panel is worse than doing nothing. */
+	if (!jdi->prepared)
+		return 0;
+
+	/*
+	 * 0x51 carries a single parameter byte on this panel: that is what the
+	 * downstream driver sends, and what hboot's own
+	 * jdiDsi_SetBacklightIntensity sends. The mipi_dsi_dcs_*_brightness
+	 * helper would put two bytes on the wire. The brightness is a runtime
+	 * value, so this uses the buffer form rather than the _seq_ macro,
+	 * whose initialisers must be compile-time constants.
+	 */
+	payload[0] = MIPI_DCS_SET_DISPLAY_BRIGHTNESS;
+	payload[1] = backlight_get_brightness(bl);
+
+	mipi_dsi_dual_dcs_write_buffer_multi(&dsi_ctx, jdi->link1, jdi->link2,
+					     payload, sizeof(payload));
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct backlight_ops jdi_panel_bl_ops = {
+	.update_status = jdi_panel_bl_update_status,
+};
+
+static int jdi_panel_add(struct jdi_panel *jdi)
+{
+	struct device *dev = &jdi->link1->dev;
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = 255,
+		/* The downstream driver's default. */
+		.brightness = 224,
+	};
+
+	jdi->mode = &default_mode;
+
+	/* The device tree supplies these two as regulators, not as GPIOs. */
+	jdi->iovdd = devm_regulator_get(dev, "iovdd");
+	if (IS_ERR(jdi->iovdd))
+		return dev_err_probe(dev, PTR_ERR(jdi->iovdd),
+				     "failed to get iovdd supply\n");
+
+	jdi->avdd = devm_regulator_get(dev, "avdd");
+	if (IS_ERR(jdi->avdd))
+		return dev_err_probe(dev, PTR_ERR(jdi->avdd),
+				     "failed to get avdd supply\n");
+
+	jdi->dcdc_en_gpio = devm_gpiod_get(dev, "dcdc-en", GPIOD_OUT_LOW);
+	if (IS_ERR(jdi->dcdc_en_gpio))
+		return dev_err_probe(dev, PTR_ERR(jdi->dcdc_en_gpio),
+				     "failed to get dcdc-en gpio\n");
+
+	jdi->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(jdi->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(jdi->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	jdi->backlight = devm_backlight_device_register(dev, dev_name(dev), dev,
+							jdi, &jdi_panel_bl_ops,
+							&props);
+	if (IS_ERR(jdi->backlight))
+		return dev_err_probe(dev, PTR_ERR(jdi->backlight),
+				     "failed to register backlight\n");
+
+	drm_panel_add(&jdi->base);
+
+	return 0;
+}
+
+static void jdi_panel_del(struct jdi_panel *jdi)
+{
+	drm_panel_remove(&jdi->base);
+
+	if (jdi->link2)
+		put_device(&jdi->link2->dev);
+}
+
+static const struct of_device_id jdi_of_match[] = {
+	{ .compatible = "jdi,lpm089a128a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, jdi_of_match);
+
+static int jdi_panel_dsi_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_device *secondary = NULL;
+	struct device_node *np;
+	struct jdi_panel *jdi;
+	int err;
+
+	/* Four lanes per link, eight in total across the two. */
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/*
+	 * Video mode without burst, with the clock lane in non-continuous mode,
+	 * which is what the downstream driver configures.
+	 */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	/* The panel registers once, on the link that names the other one. */
+	np = of_parse_phandle(dsi->dev.of_node, "link2", 0);
+	if (np) {
+		secondary = of_find_mipi_dsi_device_by_node(np);
+		of_node_put(np);
+
+		if (!secondary)
+			return -EPROBE_DEFER;
+	}
+
+	if (secondary) {
+		jdi = devm_drm_panel_alloc(&dsi->dev, __typeof(*jdi), base,
+					   &jdi_panel_funcs,
+					   DRM_MODE_CONNECTOR_DSI);
+		if (IS_ERR(jdi)) {
+			put_device(&secondary->dev);
+			return PTR_ERR(jdi);
+		}
+
+		mipi_dsi_set_drvdata(dsi, jdi);
+
+		jdi->link1 = dsi;
+		jdi->link2 = secondary;
+
+		err = jdi_panel_add(jdi);
+		if (err < 0) {
+			put_device(&secondary->dev);
+			return err;
+		}
+	}
+
+	err = mipi_dsi_attach(dsi);
+	if (err < 0) {
+		if (secondary)
+			jdi_panel_del(jdi);
+
+		return err;
+	}
+
+	return 0;
+}
+
+static void jdi_panel_dsi_remove(struct mipi_dsi_device *dsi)
+{
+	struct jdi_panel *jdi = mipi_dsi_get_drvdata(dsi);
+	int err;
+
+	/* Only the second link has no panel registered against it. */
+	if (!jdi) {
+		mipi_dsi_detach(dsi);
+		return;
+	}
+
+	err = jdi_panel_disable(&jdi->base);
+	if (err < 0)
+		dev_err(&dsi->dev, "failed to disable panel: %d\n", err);
+
+	err = mipi_dsi_detach(dsi);
+	if (err < 0)
+		dev_err(&dsi->dev, "failed to detach from DSI host: %d\n", err);
+
+	jdi_panel_del(jdi);
+}
+
+static void jdi_panel_dsi_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct jdi_panel *jdi = mipi_dsi_get_drvdata(dsi);
+
+	if (!jdi)
+		return;
+
+	jdi_panel_disable(&jdi->base);
+}
+
+static struct mipi_dsi_driver jdi_panel_dsi_driver = {
+	.driver = {
+		.name = "panel-jdi-lpm089a128a",
+		.of_match_table = jdi_of_match,
+	},
+	.probe = jdi_panel_dsi_probe,
+	.remove = jdi_panel_dsi_remove,
+	.shutdown = jdi_panel_dsi_shutdown,
+};
+module_mipi_dsi_driver(jdi_panel_dsi_driver);
+
+MODULE_AUTHOR("Nyasha <nmushambi@proton.me>");
+MODULE_DESCRIPTION("DRM driver for the JDI LPM089A128A panel");
+MODULE_LICENSE("GPL");
